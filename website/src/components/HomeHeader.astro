<header class="home-header">
  <div class="header-inner">
    <a class="mosaic-brand" href="/" aria-label="Mosaic home">
      <img class="brand-light" src="/brand/mosaic-lockup-light.svg" alt="Mosaic" width="180" height="60" />
      <img class="brand-dark" src="/brand/mosaic-lockup-dark.svg" alt="Mosaic" width="180" height="60" />
      <img class="brand-compact" src="/brand/mosaic-mark.svg" alt="" aria-hidden="true" width="30" height="35" />
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/start/overview/">Docs</a><a href="/api/">API</a><a href="/reference/performance/">Performance</a><a
        href="https://github.com/BuildMosaic/Mosaic">GitHub</a
      >
    </nav>
    <div class="header-controls">
      <button id="theme-toggle" type="button" aria-label="Use light theme">
        <svg
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"></path></svg
        >
      </button>
      <details class="mobile-nav">
        <summary aria-label="Navigation menu"
          ><svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg
          ></summary
        >
        <nav aria-label="Mobile navigation">
          <a href="/start/overview/">Docs</a><a href="/api/">API reference</a><a href="/reference/performance/"
            >Performance</a
          ><a href="https://github.com/BuildMosaic/Mosaic">GitHub</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const updateLabel = () =>
    toggle?.setAttribute(
      'aria-label',
      document.documentElement.dataset.theme === 'dark' ? 'Use light theme' : 'Use dark theme',
    );
  updateLabel();
  toggle?.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem('starlight-theme', theme);
    } catch {}
    updateLabel();
  });
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && menu?.open && !menu.contains(event.target)) menu.open = false;
  });
</script>
