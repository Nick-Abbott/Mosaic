    >
    <defs
      ><marker id="dependency-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto"
        ><path d="M0 0 L8 4 L0 8" fill="var(--m-blue)"></path></marker
      ></defs
    >
    <g class="graph-edges" fill="none" stroke-width="2" marker-end="url(#dependency-arrow)">
      <path d="M310 45 L310 62 L132 62 L132 86"></path>
      <path d="M310 45 L310 62 L498 62 L498 86"></path>
      <path d="M132 122 L132 151"></path>
      <path d="M132 122 L132 137 L498 137 L498 151"></path>
      <path d="M224 104 L310 104 L310 208"></path>
      <path d="M408 169 L350 169 L350 208"></path>
      <path d="M224 169 L270 169 L270 208"></path>
    </g>
    <g class="graph-node"
      ><rect x="227" y="9" width="166" height="36"></rect><text x="310" y="32">OrderPageTile</text></g
    >
    <g class="graph-node"
      ><rect x="38" y="86" width="186" height="36"></rect><text x="131" y="109">OrderSummaryTile</text></g
    >
    <g class="graph-node"
      ><rect x="408" y="86" width="180" height="36"></rect><text x="498" y="109">LogisticsTile</text></g
    >
    <g class="graph-node"
      ><rect x="38" y="151" width="186" height="36"></rect><text x="131" y="174">LineItemsTile</text></g
    >
    <g class="graph-node"
      ><rect x="408" y="151" width="180" height="36"></rect><text x="498" y="174">CustomerTile</text></g
    >
    <g class="graph-node graph-shared"
      ><rect x="235" y="208" width="150" height="36"></rect><text x="310" y="231">OrderTile</text></g
    >
    <path d="M427 209 L442 224 L427 239 L412 224Z" fill="var(--m-orange)"></path>
    <text class="graph-note" x="453" y="228">shared work</text>
  </svg>
  <div
    class="mobile-composition"
    role="img"
    aria-label="OrderPageTile composes summary and logistics. Summary composes customer, line items, and order. Customer and line items also share OrderTile."
  >
    <code>OrderPageTile</code><span>composes summary + logistics</span>
    <div><code>OrderSummaryTile</code><span>directly needs OrderTile</span></div>
    <div><code>CustomerTile + LineItemsTile</code><span>each also needs OrderTile</span></div>
    <code class="mobile-shared">OrderTile <small>shared by three branches</small></code>
  </div>
  <figcaption>Three branches. One OrderTile execution per Mosaic.</figcaption>
</figure>
