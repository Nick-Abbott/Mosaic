---
interface Props {
  external?: boolean;
}
const { external = false } = Astro.props;
---

<svg
  class="link-arrow"
  width="16"
  height="16"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  aria-hidden="true"
  focusable="false"><path d={external ? 'M5 19 19 5M5 5h14v14' : 'M4 12h16m-6-6 6 6-6 6'}></path></svg
>
<style>
  .link-arrow {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }
</style>
